# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Target Chat ID (bisa Chat ID personal atau Grup ID yang diawali tanda minus misal: -100xxxxxxxxxx)
TARGET_CHAT_ID=

# Link Absensi Kantor
